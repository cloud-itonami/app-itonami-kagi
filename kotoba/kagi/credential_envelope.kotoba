;; Experimental recipient-encrypted credential envelope (AWAI-71).
;; This is a complete byte-level seal/open component, not a broker, issuer,
;; authorization decision, replay journal, secure host or production release.
;; Host supplies fresh independent CSPRNG values, authenticates the recipient
;; and the exact canonical context, and bounds/clears access to plaintext.
;; It must enforce scope, purpose, expiry, revocation and audit independently.
;; The underlying native cryptography does not claim constant-time execution.
;; This version is deliberately distinct from historical kagi/kem/v1 grants.
(ns kagi.credential-envelope
  (:require [pqh.hybrid :as kem] [chacha20.aead :as aead] [x25519.core :as x])
  (:export [credential-seal credential-open]))

;; Wire v1: magic(4) || ephemeral X25519 public(32) || ML-KEM ciphertext(1088)
;; || nonce(12) || ciphertext and Poly1305 tag. Exact context is supplied by
;; trusted caller and bound both into the KEM info and AEAD associated data.
;; Seal returns [] on refusal; open returns [-1] on any failure. Tokens are
;; nonempty byte strings; successful opening therefore cannot equal [-1].
(defn- ke-slice [v :vector-i64 start :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)]
    (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- ke-cat [a :vector-i64 b :vector-i64] :vector-i64
  (let [n (vector-count a) m (vector-count b)]
    (loop [i 0 out (vector-alloc (+ n m))]
      (if (= i (+ n m)) out
        (recur (+ i 1) (vector-assoc! out i (if (< i n) (vector-at a i) (vector-at b (- i n)))))))))
(defn- ke-bytes? [v :vector-i64] :bool
  (loop [i 0] (if (= i (vector-count v)) true
    (if (and (>= (vector-at v i) 0) (<= (vector-at v i) 255)) (recur (+ i 1)) false))))
(defn- ke-same? [a :vector-i64 b :vector-i64] :bool
  (and (= (vector-count a) (vector-count b))
    (loop [i 0] (if (= i (vector-count a)) true
      (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- ke-magic [] :vector-i64 (vector-i64 75 71 67 1))
(defn- ke-context [context :vector-i64] :vector-i64
  (ke-cat (vector-i64 107 97 103 105 47 99 114 101 100 101 110 116 105 97 108 45 101 110 118 101 108 111 112 101 47 118 49 0) context))
(defn- ke-context? [context :vector-i64] :bool
  (and (> (vector-count context) 0) (<= (vector-count context) 1024) (ke-bytes? context)))
(defn credential-seal [recipient :vector-i64 context :vector-i64 plaintext :vector-i64
                      ephemeral :vector-i64 message-random :vector-i64 nonce :vector-i64] :vector-i64
  (if (or (not (= (vector-count recipient) 1216)) (not (ke-bytes? recipient))
          (not (ke-context? context)) (< (vector-count plaintext) 1) (> (vector-count plaintext) 4096)
          (not (ke-bytes? plaintext)) (not (= (vector-count nonce) 12)) (not (ke-bytes? nonce))) (vector-i64)
    (let [aad (ke-context context)
          k (kem/encapsulate ephemeral message-random (ke-slice recipient 0 32) (ke-slice recipient 32 1184) aad)]
      (if (not (= (vector-count k) 1152)) (vector-i64)
        (let [sealed (aead/seal (ke-slice k 0 32) nonce aad plaintext)]
          (if (not (= (vector-count sealed) (+ (vector-count plaintext) 16))) (vector-i64)
            (ke-cat (ke-cat (ke-cat (ke-magic) (ke-slice k 32 1120)) nonce) sealed)))))))
(defn credential-open [recipient :vector-i64 context :vector-i64 envelope :vector-i64
                      x-secret :vector-i64 kem-secret :vector-i64] :vector-i64
  (if (or (not (= (vector-count recipient) 1216)) (not (ke-bytes? recipient))
          (not (ke-context? context)) (< (vector-count envelope) 1153) (> (vector-count envelope) 5248)
          (not (ke-bytes? envelope)) (not (ke-same? (ke-slice envelope 0 4) (ke-magic)))
          (not (= (vector-count x-secret) 32)) (not (ke-bytes? x-secret))
          (not (= (vector-count kem-secret) 2400)) (not (ke-bytes? kem-secret))) (vector-i64 -1)
    ;; The public keys are bound to the private recipient before decapsulation.
    (if (or (not (ke-same? (x/public-key x-secret) (ke-slice recipient 0 32)))
            (not (ke-same? (ke-slice kem-secret 1152 1184) (ke-slice recipient 32 1184)))) (vector-i64 -1)
      (let [aad (ke-context context)
            key (kem/decapsulate x-secret kem-secret (ke-slice envelope 4 32) (ke-slice envelope 36 1088)
                                 (ke-slice recipient 0 32) (ke-slice recipient 32 1184) aad)]
        (if (not (= (vector-count key) 32)) (vector-i64 -1)
          (aead/open key (ke-slice envelope 1124 12) aad
                     (ke-slice envelope 1136 (- (vector-count envelope) 1136))))))))
