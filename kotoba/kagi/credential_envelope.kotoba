;; Experimental recipient-encrypted credential envelope (AWAI-71).
;; This is a complete byte-level seal/open component, not a broker, issuer,
;; authorization decision, replay journal, secure host or production release.
;; Host supplies fresh independent CSPRNG values, authenticates the recipient
;; and the exact canonical context, and bounds/clears access to plaintext.
;; It must enforce scope, purpose, expiry, revocation and audit independently.
;; The underlying native cryptography does not claim constant-time execution.
;; This version is deliberately distinct from historical kagi/kem/v1 grants.
(ns kagi.credential-envelope
  (:require [pqh.hybrid :as kem] [chacha20.aead :as aead] [x25519.core :as x]
            [sha2.core :as sha] [ed25519.selfhost :as ed])
  (:export [credential-seal credential-open-unverified credential-signing-message credential-open-signed
            github-checkpoint-context github-checkpoint-open github-checkpoint-open-issued]))

;; Wire v1: magic(4) || ephemeral X25519 public(32) || ML-KEM ciphertext(1088)
;; || nonce(12) || ciphertext and Poly1305 tag. Exact context is supplied by
;; trusted caller and bound both into the KEM info and AEAD associated data.
;; Seal returns [] on refusal; open returns [-1] on any failure. Tokens are
;; nonempty byte strings; successful opening therefore cannot equal [-1].
(defn- ke-slice [v :vector-i64 start :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)]
    (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- ke-cat [a :vector-i64 b :vector-i64] :vector-i64
  (let [n (vector-count a) m (vector-count b)]
    (loop [i 0 out (vector-alloc (+ n m))]
      (if (= i (+ n m)) out
        (recur (+ i 1) (vector-assoc! out i (if (< i n) (vector-at a i) (vector-at b (- i n)))))))))
(defn- ke-bytes? [v :vector-i64] :bool
  (loop [i 0] (if (= i (vector-count v)) true
    (if (and (>= (vector-at v i) 0) (<= (vector-at v i) 255)) (recur (+ i 1)) false))))
(defn- ke-same? [a :vector-i64 b :vector-i64] :bool
  (and (= (vector-count a) (vector-count b))
    (loop [i 0] (if (= i (vector-count a)) true
      (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- ke-magic [] :vector-i64 (vector-i64 75 71 67 1))
(defn- ke-context [context :vector-i64] :vector-i64
  (ke-cat (vector-i64 107 97 103 105 47 99 114 101 100 101 110 116 105 97 108 45 101 110 118 101 108 111 112 101 47 118 49 0) context))
(defn- ke-context? [context :vector-i64] :bool
  (and (> (vector-count context) 0) (<= (vector-count context) 1024) (ke-bytes? context)))
(defn credential-seal [recipient :vector-i64 context :vector-i64 plaintext :vector-i64
                      ephemeral :vector-i64 message-random :vector-i64 nonce :vector-i64] :vector-i64
  (if (or (not (= (vector-count recipient) 1216)) (not (ke-bytes? recipient))
          (not (ke-context? context)) (< (vector-count plaintext) 1) (> (vector-count plaintext) 4096)
          (not (ke-bytes? plaintext)) (not (= (vector-count nonce) 12)) (not (ke-bytes? nonce))) (vector-i64)
    (let [aad (ke-context context)
          k (kem/encapsulate ephemeral message-random (ke-slice recipient 0 32) (ke-slice recipient 32 1184) aad)]
      (if (not (= (vector-count k) 1152)) (vector-i64)
        (let [sealed (aead/seal (ke-slice k 0 32) nonce aad plaintext)]
          (if (not (= (vector-count sealed) (+ (vector-count plaintext) 16))) (vector-i64)
            (ke-cat (ke-cat (ke-cat (ke-magic) (ke-slice k 32 1120)) nonce) sealed)))))))
(defn credential-open-unverified [recipient :vector-i64 context :vector-i64 envelope :vector-i64
                      x-secret :vector-i64 kem-secret :vector-i64] :vector-i64
  (if (or (not (= (vector-count recipient) 1216)) (not (ke-bytes? recipient))
          (not (ke-context? context)) (< (vector-count envelope) 1153) (> (vector-count envelope) 5248)
          (not (ke-bytes? envelope)) (not (ke-same? (ke-slice envelope 0 4) (ke-magic)))
          (not (= (vector-count x-secret) 32)) (not (ke-bytes? x-secret))
          (not (= (vector-count kem-secret) 2400)) (not (ke-bytes? kem-secret))) (vector-i64 -1)
    ;; The public keys are bound to the private recipient before decapsulation.
    (if (or (not (ke-same? (x/public-key x-secret) (ke-slice recipient 0 32)))
            (not (ke-same? (ke-slice kem-secret 1152 1184) (ke-slice recipient 32 1184)))) (vector-i64 -1)
      (let [aad (ke-context context)
            key (kem/decapsulate x-secret kem-secret (ke-slice envelope 4 32) (ke-slice envelope 36 1088)
                                 (ke-slice recipient 0 32) (ke-slice recipient 32 1184) aad)]
        (if (not (= (vector-count key) 32)) (vector-i64 -1)
          (aead/open key (ke-slice envelope 1124 12) aad
                     (ke-slice envelope 1136 (- (vector-count envelope) 1136))))))))

;; The issuer signs this domain-separated digest, not a caller-selected hash.
;; The two-byte context length unambiguously frames the only variable-length
;; field before the envelope; recipient is fixed length. Issuer authorization,
;; policy, trusted context and signature acquisition remain host obligations.
(defn credential-signing-message [recipient :vector-i64 context :vector-i64 envelope :vector-i64] :vector-i64
  (if (or (not (= (vector-count recipient) 1216)) (not (ke-bytes? recipient))
          (not (ke-context? context)) (< (vector-count envelope) 1153) (> (vector-count envelope) 5248)
          (not (ke-bytes? envelope)) (not (ke-same? (ke-slice envelope 0 4) (ke-magic)))) (vector-i64)
    (let [n (vector-count context)
          domain (vector-i64 107 97 103 105 47 99 114 101 100 101 110 116 105 97 108 45 105 115 115 117 97 110 99 101 47 118 49 0)
          lengths (vector-i64 (quot n 256) (rem n 256))]
      (sha/sha256 (ke-cat (ke-cat (ke-cat (ke-cat domain recipient) lengths) context) envelope)))))

;; A signature proves possession of the supplied issuer key only. The host
;; MUST independently pin that key, authenticate its policy and enforce
;; expiry, revocation and replay before making the returned bytes available.
(defn credential-open-signed [recipient :vector-i64 context :vector-i64 envelope :vector-i64
                             issuer :vector-i64 signature :vector-i64
                             x-secret :vector-i64 kem-secret :vector-i64] :vector-i64
  (let [message (credential-signing-message recipient context envelope)]
    (if (or (not (= (vector-count message) 32)) (not (= (vector-count issuer) 32))
            (not (ke-bytes? issuer)) (not (= (vector-count signature) 64)) (not (ke-bytes? signature))
            (not (ed/prime-order-key? issuer)) (not (ed/verify? issuer message signature))) (vector-i64 -1)
      (credential-open-unverified recipient context envelope x-secret kem-secret))))

;; A narrow candidate profile for the bot state repository. The principal,
;; audience, lease ID and interval are trusted host inputs: matching a signed
;; context does not establish that any of them are authorized or current.
;; Times are Unix milliseconds, expiry is exclusive, and the longest lease is
;; one hour. The host must use the GitHub-reported token expiry as an upper
;; bound and separately establish revocation and replay policy.
(defn- ke-label? [s :string] :bool
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (and (> n 0) (<= n 128)
      (loop [i 0] (if (= i n) true
        (let [c (vector-at v i)]
          (if (or (and (>= c 97) (<= c 122)) (and (>= c 48) (<= c 57))
                  (= c 45) (= c 46) (= c 58) (= c 95)) (recur (+ i 1)) false)))))))
(defn- ke-lease-id? [s :string] :bool
  (let [v (vector-i64-from-bytes (string-to-utf8 s))]
   (and (= (vector-count v) 64)
    (loop [i 0 nonzero false] (if (= i 64) nonzero
      (let [c (vector-at v i)]
        (if (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 102)))
          (recur (+ i 1) (or nonzero (not (= c 48)))) false)))))))
(defn github-checkpoint-context [principal :string audience :string lease-id :string
                                issued-ms :i64 expires-ms :i64] :vector-i64
  (if (or (not (ke-label? principal)) (not (ke-label? audience)) (not (ke-lease-id? lease-id))
          (< issued-ms 0) (<= expires-ms issued-ms) (> (- expires-ms issued-ms) 3600000)) (vector-i64)
    (vector-i64-from-bytes (string-to-utf8
      (str "kagi.github.lease.v1\nrepository=cloud-itonami/itonami-bot-state\n"
           "permission=contents-write-metadata-read\npurpose=bot-checkpoint\nprincipal=" principal
           "\naudience=" audience "\nlease=" lease-id "\nissued-ms=" (string-from-i64 issued-ms)
           "\nexpires-ms=" (string-from-i64 expires-ms) "\n")))))
(defn github-checkpoint-open [recipient :vector-i64 envelope :vector-i64 issuer :vector-i64 signature :vector-i64
                             x-secret :vector-i64 kem-secret :vector-i64 principal :string audience :string
                             lease-id :string issued-ms :i64 expires-ms :i64 now-ms :i64] :vector-i64
  (let [context (github-checkpoint-context principal audience lease-id issued-ms expires-ms)]
    (if (or (= (vector-count context) 0) (< now-ms 0) (< now-ms issued-ms) (>= now-ms expires-ms))
      (vector-i64 -1)
      (credential-open-signed recipient context envelope issuer signature x-secret kem-secret))))

;; Open the signed-issuance component's signature(64) || envelope format.
;; The host independently authenticates and pins issuer, principal, audience
;; and clock, and must enforce revocation/replay and protect plaintext. Invalid
;; framing, context, signature or cryptography returns [-1], never an empty
;; credential. This does not itself authorize or deliver a GitHub token.
(defn github-checkpoint-open-issued [recipient :vector-i64 issued :vector-i64 issuer :vector-i64
                                    x-secret :vector-i64 kem-secret :vector-i64 principal :string audience :string
                                    lease-id :string issued-ms :i64 expires-ms :i64 now-ms :i64] :vector-i64
  (let [n (vector-count issued)]
    (if (or (< n 1217) (> n 5312)) (vector-i64 -1)
      (github-checkpoint-open recipient (ke-slice issued 64 (- n 64)) issuer (ke-slice issued 0 64)
                              x-secret kem-secret principal audience lease-id issued-ms expires-ms now-ms))))
