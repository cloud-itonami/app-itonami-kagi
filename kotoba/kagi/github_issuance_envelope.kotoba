;; Experimental composition: validate a GitHub installation-token response,
;; bind its reported expiry to a host-selected checkpoint lease, and seal the
;; token to a recipient. The host authenticates the HTTP endpoint, pins repo ID
;; and installation, authorizes principal/recipient, controls clock and random
;; inputs, obtains issuer signature, and handles secret lifetime. This is not a
;; network client, credential issuer, replay ledger or qualified secret host.
(ns kagi.github-issuance-envelope
  (:require [kagi.github-token-response :as response] [kagi.credential-envelope :as envelope]
            [kagi.github-lease-policy :as policy] [ed25519.selfhost :as ed])
  (:export [github-checkpoint-seal-approved github-checkpoint-signed-issue]))

(defn- gi-bytes? [v :vector-i64] :bool
  (loop [i 0]
    (if (= i (vector-count v)) true
      (and (>= (vector-at v i) 0) (<= (vector-at v i) 255) (recur (+ i 1))))))
(defn- gi-equal? [a :vector-i64 b :vector-i64] :bool
  (and (= (vector-count a) (vector-count b))
       (loop [i 0]
         (if (= i (vector-count a)) true
           (and (= (vector-at a i) (vector-at b i)) (recur (+ i 1)))))))
;; Best-effort clearing of this temporary vector after sealing. The HTTP body,
;; crypto temporaries, allocator copies and OS buffers remain host duties.
(defn- gi-clear! [v :vector-i64] :bool
  (loop [i 0]
    (if (= i (vector-count v)) true
      (let [ignored (vector-assoc! v i 0)] (recur (+ i 1))))))
(defn- gi-join [a :vector-i64 b :vector-i64] :vector-i64
  (let [n (vector-count a) m (vector-count b)]
    (loop [i 0 out (vector-alloc (+ n m))]
      (if (= i (+ n m)) out
        (recur (+ i 1) (vector-assoc! out i (if (< i n) (vector-at a i) (vector-at b (- i n)))))))))

(defn- github-checkpoint-seal-response [body :vector-i64 status :i64 repo-id :i64 now-ms :i64
                                      recipient :vector-i64 principal :string audience :string lease-id :string
                                      ephemeral :vector-i64 message-random :vector-i64 nonce :vector-i64] :vector-i64
  (let [expiry (response/github-checkpoint-token-expiry body status repo-id now-ms)]
    (if (< expiry 0) (vector-i64)
      (let [context (envelope/github-checkpoint-context principal audience lease-id now-ms expiry)]
        (if (= (vector-count context) 0) (vector-i64)
          (let [token (response/github-checkpoint-token body status repo-id now-ms)]
            (if (= (vector-count token) 0) (vector-i64)
              (let [box (envelope/credential-seal recipient context token ephemeral message-random nonce)
                    cleared (gi-clear! token)] box))))))))

;; The issuer must already have authenticated the policy, principal,
;; recipient and provider transport. This composition narrows the generic
;; policy to the checkpoint envelope's fixed repo, write permission and
;; purpose. Budget is [max-ttl-seconds requested-ttl-seconds repository-id].
;; A failed post-issuance check does not revoke the upstream credential;
;; the host must retain unknown state and reconcile revocation/expiry.
(defn github-checkpoint-seal-approved [body :vector-i64 status :i64 now-ms :i64 budget :vector-i64
                                     policy-repo :string policy-principal :string allow-write :bool
                                     recipient :vector-i64 principal :string audience :string lease-id :string
                                     ephemeral :vector-i64 message-random :vector-i64 nonce :vector-i64] :vector-i64
  (let [repo "cloud-itonami/itonami-bot-state"
        admitted (= (policy/github-lease-request-problem policy-repo policy-principal allow-write
                      repo principal "checkpoint-archive" "contents:write" budget) "lease/request-eligible")]
    (if (or (not admitted) (< now-ms 1000) (> now-ms (- 9007199254740991 3600000))) (vector-i64)
      (let [repo-id (vector-at budget 2) ttl (vector-at budget 1)
            checked (policy/github-lease-provider-response-problem repo repo-id "contents:write"
                      (quot now-ms 1000) ttl status body)
            expiry (if (= checked "lease/provider-eligible")
                     (response/github-checkpoint-token-expiry body status repo-id now-ms) -1)]
        (if (or (< expiry 0) (> expiry (+ now-ms (* ttl 1000)))) (vector-i64)
          (github-checkpoint-seal-response body status repo-id now-ms recipient principal audience lease-id
                                           ephemeral message-random nonce))))))

;; Experimental byte-level composition for a trusted host. Returns exactly
;; signature(64) || encrypted envelope, or [] on refusal. The independently
;; pinned issuer must match the seed; the signature covers the same recipient,
;; provider-reported expiry and policy-bound context used by the envelope.
;; This is not an issuer, secure key handle, replay journal or deployment
;; authorization. The host must authenticate policy and requester, pin the
;; provider/clock, protect and erase secrets, and reconcile failed issuance.
(defn github-checkpoint-signed-issue [body :vector-i64 status :i64 now-ms :i64 budget :vector-i64
                                     policy-repo :string policy-principal :string allow-write :bool
                                     recipient :vector-i64 principal :string audience :string lease-id :string
                                     ephemeral :vector-i64 message-random :vector-i64 nonce :vector-i64
                                     issuer-seed :vector-i64 issuer :vector-i64] :vector-i64
  (if (or (not (= (vector-count issuer-seed) 32)) (not (gi-bytes? issuer-seed))
          (not (= (vector-count issuer) 32)) (not (gi-bytes? issuer))
          (not (ed/prime-order-key? issuer)) (not (gi-equal? (ed/public-from-seed issuer-seed) issuer)))
    (vector-i64)
    (let [box (github-checkpoint-seal-approved body status now-ms budget policy-repo policy-principal allow-write
                                                recipient principal audience lease-id ephemeral message-random nonce)
          expiry (if (= (vector-count budget) 3)
                   (response/github-checkpoint-token-expiry body status (vector-at budget 2) now-ms) -1)
          context (if (> expiry now-ms) (envelope/github-checkpoint-context principal audience lease-id now-ms expiry) (vector-i64))
          message (envelope/credential-signing-message recipient context box) signature (vector-alloc 64)]
      (if (not (= (vector-count message) 32)) (vector-i64)
        (if (= (ed/sign-into signature issuer-seed message) 0)
          (gi-join signature box) (vector-i64))))))
