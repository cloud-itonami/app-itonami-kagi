;; Native local-software signer host. Its private scope is never granted to
;; an app/LLM/browser. Management and delegate seeds have separate files;
;; routine signing reads only the author. No old vault or ambient home.
(ns kagi.host (:export [main]))

(defn kh-nul [] :string (string-from-utf8 (bytes-from-vector-i64 (vector-alloc 1))))
(defn kh-private [op :string root :string name :string tail :string] :string
  (let [frame (str (kh-nul) "KPV1" (kh-nul) op root "/" name tail)
        answer (vector-i64-from-bytes (typed-cap-call 35 :bytes :bytes (string-to-utf8 frame)))]
    (if (and (> (vector-count answer) 0) (= (vector-at answer 0) 1))
      (string-from-utf8 (bytes-from-vector-i64 (vector-drop answer 1))) "")))
(defn kh-read [root :string name :string] :string (kh-private "R" root name ""))
;; C/A success contains only status 1, so use a separate boolean wrapper.
(defn kh-write [op :string root :string name :string tail :string] :bool
  (let [frame (str (kh-nul) "KPV1" (kh-nul) op root "/" name tail)
        answer (vector-i64-from-bytes (typed-cap-call 35 :bytes :bytes (string-to-utf8 frame)))]
    (and (= (vector-count answer) 1) (= (vector-at answer 0) 1))))
(defn kh-create [root :string name :string value :string] :bool
  (kh-write "C" root name (str (kh-nul) value)))
(defn kh-now [] :i64 (kg-number (typed-cap-call 7 :string :string "wall")))
(defn kh-sign-text [seed :string text :string] :string
  (if (not (kg-hex? seed 64)) ""
    (let [out (vector-alloc 64) result (sign-into out (hex-bytes seed) (kg-bytes text))]
      (if (= result 0) (hex out) ""))))
(defn kh-fields [line :string start :i64 end :i64] :string
  (loop [i start out ""]
    (if (= i end) out (recur (+ i 1) (str out (if (= i start) "" " ") (kg-field line i))))))
(defn kh-config? [config :string] :bool
  (and (kg-line? config 6) (= (kg-field config 0) "kagi.host.local.v1")
       (kg-hex? (kg-field config 1) 64) (kg-hex? (kg-field config 2) 64)
       (> (kg-number (kg-field config 3)) 0) (kg-hex? (kg-field config 4) 64)
       (kg-public? (kg-field config 5))))
(defn kh-state [root :string config :string] :string
  (if (not (kh-config? config)) ""
    (let [state (kc-verify-bundle (kh-read root "keyset.bundle") (kg-field config 1))]
      (if (and (= (kg-state-problem state) "") (= (kg-field state 2) (kg-field config 2))
               (= (kg-field state 5) (kg-field config 5))) state ""))))
(defn kh-header [config :string] :string (str "kagi.host.journal.v1 " (kg-hash config)))
(defn kh-day [ms :i64] :i64 (quot ms 86400000))
;; A funds journal entry carries the transfer fields, so replay can rebuild the
;; TransferBody, check the permit's body digest and verify the author's
;; signature over the transfer-id (not over the permit, as for agent entries).
;; kagi.host.fentry.v1 COMMIT_MS PERMIT(13) DELEGATE AUTHOR_SIG_HEX PREV_HASH RECEIVER AMOUNT SPENDER_PREV NONCE TS
(defn kh-fentry-ok? [cursor :string line :string state :string policy :string fence :i64] :bool
  (let [now (kg-number (kg-field line 1)) permit (kh-fields line 2 15)
        delegate (kg-field line 15) sig (kg-field line 16)
        body (kg-transfer-body (kg-did-of (kg-field state 5)) (kg-field line 18) (kg-field line 19)
                               (kg-field line 20) (kg-field line 21) (kg-field line 22))]
    (and (= (kg-field policy 1) "funds")
         (>= now (kg-number (kg-field cursor 2)))
         (= (kg-field line 17) (kg-field cursor 4))
         (= (kg-permit-problem state policy permit delegate now (kg-number (kg-field cursor 1)) fence (kg-field cursor 3)) "")
         (kg-did-key? (kg-field line 18)) (> (kg-number (kg-field line 19)) 0)
         (= (kg-hash body) (kg-field permit 7))
         (kg-verify (kg-field state 5) (kg-transfer-id body) sig))))
(defn kh-cursor-step [cursor :string line :string state :string policy :string fence :i64] :string
  (if (= (kg-field line 0) "kagi.host.fentry.v1")
    (if (and (kg-line? line 23) (= (arena-scope (if (kh-fentry-ok? cursor line state policy fence) 1 0)) 1))
      (str "kagi.host.cursor.v1 " (kg-field line 12) " " (kg-field line 1) " " (kg-field line 9) " " (kg-hash line)) "")
  (if (not (kg-line? line 18)) ""
    (let [now (kg-number (kg-field line 1)) permit (kh-fields line 2 15)
          delegate (kg-field line 15) author (kg-field line 16)]
      (if (= (arena-scope (if (and (= (kg-field line 0) "kagi.host.entry.v1")
               (>= now (kg-number (kg-field cursor 2)))
               (= (kg-field line 17) (kg-field cursor 4))
               (= (kg-permit-problem state policy permit delegate now
                    (kg-number (kg-field cursor 1)) fence (kg-field cursor 3)) "")
               (kg-verify (kg-field state 5) (kg-permit-message permit) author)) 1 0)) 1)
        (str "kagi.host.cursor.v1 " (kg-field permit 10) " " now " " (kg-field permit 7) " " (kg-hash line)) "")))))
(defn kh-cursor [journal :string config :string state :string policy :string] :string
  (let [header (str (kh-header config) "\n") h (string-length header) n (string-length journal)]
    (if (or (< n h) (> n 1048576) (not= (string-substring journal 0 h) header)) ""
      (loop [start h count 0 cursor (str "kagi.host.cursor.v1 0 0 " (kg-field config 4) " " (kg-hash (kh-header config)))]
        (if (= start n) cursor
          (if (or (>= count 4096) (= cursor "")) ""
            (let [end (kc-line-end journal start)]
              (if (= end n) ""
                (let [line (string-substring journal start end)
                      next (kh-cursor-step cursor line state policy (kg-number (kg-field config 3)))]
                  (recur (+ end 1) (+ count 1) next))))))))))
;; The amount already signed today (UTC day), derived from the journal that
;; kh-cursor has just verified in full; it is never taken from a caller.
(defn kh-spent [journal :string config :string today :i64] :i64
  (let [n (string-length journal) h (string-length (str (kh-header config) "\n"))]
    (loop [start h total 0]
      (if (>= start n) total
        (let [end (kc-line-end journal start) line (string-substring journal start end)]
          (recur (+ end 1)
                 (if (and (= (kg-field line 0) "kagi.host.fentry.v1") (= (kh-day (kg-number (kg-field line 1))) today))
                   (+ total (kg-number (kg-field line 19))) total)))))))
;; Refusal log (JUN-549). Funds requests the host refuses are recorded in a file
;; separate from the signing journal, so spent / sequence / parent never depend on
;; it. kagi.host.refusal.v1 TIME COMMAND REASON REQUEST_SHA256 PREV_HASH, chained to
;; a header that names the config. It is bounded at 256 entries: the 256th is a
;; fixed capacity marker and nothing is written after it, so a flood of refused
;; requests cannot fill the disk. No seed, signature or allowlist text is recorded.
(defn kh-refusals-header [config :string] :string (str "kagi.host.refusals.v1 " (kg-hash config)))
(defn kh-refusals-scan [text :string config :string] :string
  (let [header (str (kh-refusals-header config) "\n") h (string-length header) n (string-length text)]
    (if (or (< n h) (> n 65536) (not= (string-substring text 0 h) header)) ""
      (loop [start h count 0 last (kg-hash (kh-refusals-header config))]
        (if (= start n) (str count " " last)
          (if (>= count 256) ""
            (let [end (kc-line-end text start)]
              (if (= end n) ""
                (let [line (string-substring text start end)]
                  (if (and (kg-line? line 6) (= (kg-field line 0) "kagi.host.refusal.v1") (= (kg-field line 5) last))
                    (recur (+ end 1) (+ count 1) (kg-hash line)) ""))))))))))
(defn kh-log-refusal [root :string config :string command :string reason :string digest :string] :bool
  (let [text (kh-read root "refusals") scan (kh-refusals-scan text config)]
    (if (= scan "") false
      (let [count (kg-number (kg-field scan 0)) last (kg-field scan 1)]
        (if (>= count 256) false
          (let [marker (= count 255)
                entry (str "kagi.host.refusal.v1 " (kh-now) " " (if marker "log" command) " "
                           (if marker "log/capacity-reached" reason) " " (if marker (kg-zero 64) digest) " " last)]
            (kh-write "A" root "refusals" (str (kh-nul) text (kh-nul) entry "\n"))))))))
;; The binding file is the binding line, LF, then the verified identity keyset
;; bundle. It is re-verified on every funds operation, so a damaged or swapped
;; file stops signing instead of being trusted from creation time.
(defn kh-bound? [root :string state :string] :bool
  (let [text (kh-read root "binding") end (kc-line-end text 0)]
    (and (> (string-length text) 0) (< (+ end 1) (string-length text))
         (let [binding (string-substring text 0 end)
               bundle (string-substring text (+ end 1) (string-length text))]
           (= (kg-binding-problem binding (kc-verify-bundle bundle (kg-field binding 3)) (kg-field state 5)) "")))))
(defn kh-ready? [state :string policy :string cursor :string] :bool
  (and (= (kg-state-problem state) "") (= (kg-field state 4) "active")
       (= (kg-policy-problem policy) "") (= (kg-hash policy) (kg-field state 6))
       (kg-line? cursor 5)))
(defn kh-status-text [state :string cursor :string now :i64] :string
  (str "{\"schema\":\"kagi.host.status.v1\",\"mode\":\"local-software\",\"independentCustody\":false,\"productionQualified\":false,\"author\":\"" (kg-field state 5) "\",\"keyset\":\"" (kg-field state 1) "\",\"head\":\"" (kg-field state 2) "\",\"sequence\":" (kg-field cursor 1) ",\"lastWallMs\":" (kg-field cursor 2) ",\"observedAtMs\":" now ",\"nodeConnected\":false,\"cellConnected\":false}\n"))
(defn kh-publish-status [root :string directory :string] :i64
  (let [config (kh-read root "config") state (kh-state root config)
        policy (kh-read root "policy") journal (kh-read root "journal")
        cursor (kh-cursor journal config state policy) now (kh-now)]
    (if (or (not (kh-ready? state policy cursor)) (< now (kg-number (kg-field cursor 2)))) 2
      (let [tmp (str directory "/signer-status.json.tmp") final (str directory "/signer-status.json")
            status (kh-status-text state cursor now)
            written (typed-cap-call 35 :string :string (str tmp "WRITE" "_SEP" status))
            flushed (typed-cap-call 35 :string :string (str tmp "FSYNC" "_SEP"))
            moved (if (= flushed "1") (typed-cap-call 35 :string :string (str tmp "RENAME" "_SEP" final)) "0")
            durable (if (= moved "1") (typed-cap-call 35 :string :string (str directory "FSYNC" "_SEP")) "0")]
        (if (= durable "1") 0 2)))))
(defn kh-watch [root :string directory :string count :i64] :i64
  (loop [i 0]
    (if (= i count) 0
      (let [result (arena-scope (kh-publish-status root directory))]
        (if (not= result 0) (kc-error "status proof/journal/clock/publication refused")
          (let [wait (typed-cap-call 7 :string :string "sleep 5000")] (recur (+ i 1))))))))

;; Initialization is intentionally named local: one administrator controls
;; the software host, author and guardian. This is not independent custody.
;; All creates are exclusive. Config is published LAST, so a partial init
;; cannot become a ready signer. Existing files are never overwritten.
(defn kh-init [root :string] :i64
  (let [author (typed-cap-call 23 :string :string "32")
        guardian (typed-cap-call 23 :string :string "32")
        delegate (typed-cap-call 23 :string :string "32")
        public (hex (public-from-seed (hex-bytes author)))
        gp (hex (public-from-seed (hex-bytes guardian)))
        dp (hex (public-from-seed (hex-bytes delegate)))
        funds (= (kc-arg 2) "funds")
        allow (if funds (typed-cap-call 35 :string :string (kc-arg 9)) "")
        policy (str "kagi.agent.policy.v1 " (kc-arg 2) " " (kc-arg 3) " " (kc-arg 4) " " dp " " (kc-arg 5) " " (kc-arg 6)
                    (if funds (str " " (kc-arg 7) " " (kc-arg 8) " " (kg-hash allow)) ""))]
    (if (or (= root "") (not (if funds (and (not= allow "") (= (kc-arg 10) "")) (= (kc-arg 7) ""))) (not= (kg-policy-problem policy) ""))
      (kc-error "usage: init-local PRIVATE_ROOT agent|node SCOPE AUDIENCE PURPOSE MAX_TTL_MS | init-local PRIVATE_ROOT funds SCOPE AUDIENCE en-transfer MAX_TTL_MS MAX_AMOUNT DAILY_CAP ALLOWLIST_FILE")
      (let [event (kg-event "genesis" 0 (kg-zero 64) public (kg-hash policy) (str gp (kg-zero 128)) 1)
            pin (kg-hash event)
            manage (str (kh-sign-text guardian (str "kagi.keyset.manage.v1\n" event)) (kg-zero 256))
            proof (kh-sign-text author (str "kagi.keyset.author.v1\n" event))
            state (kg-apply "" pin event manage proof)
            config (str "kagi.host.local.v1 " pin " " pin " 1 " (kg-zero 64) " " public)]
        (if (or (not= (kg-state-problem state) "")
                (not (kh-create root "author.seed" author))
                (not (kh-create root "guardian.seed" guardian))
                (not (kh-create root "delegate.seed" delegate))
                (not (kh-create root "policy" policy))
                (and funds (not (kh-create root "allowlist" allow)))
                (and funds (not (kh-create root "refusals" (str (kh-refusals-header config) "\n"))))
                (not (kh-create root "keyset.bundle" (str event " " manage " " proof "\n")))
                (not (kh-create root "journal" (str (kh-header config) "\n")))
                (not (kh-create root "config" config)))
          (kc-error "private create/init refused; existing or partial stores are never overwritten")
          (kc-output (str "{\"schema\":\"kagi.host.init.v1\",\"mode\":\"local-software\",\"independentCustody\":false,\"genesis\":\"" pin "\",\"author\":\"" public "\",\"delegate\":\"" dp "\"}\n")))))))
;; halt-local is deliberately independent of keyset/journal state, so it still
;; works when the rest of the root is unreadable. It is an exclusive create:
;; the host never removes the file (resuming is the operator's OS-level act).
(defn kh-halt [root :string] :i64
  (if (kh-create root "halt" (str (kh-now) " halted by operator"))
    (kc-output "{\"schema\":\"kagi.host.halt.v1\",\"halted\":true}\n")
    (kc-error "halt refused (already halted, or the root is unavailable)")))
(defn kh-operate [command :string root :string] :i64
  (let [config (kh-read root "config") state (kh-state root config)
        policy (kh-read root "policy") journal (kh-read root "journal")
        cursor (kh-cursor journal config state policy) now (kh-now)]
    (cond
      (or (not (kh-ready? state policy cursor)) (< now (kg-number (kg-field cursor 2))))
        (kc-error "host state/proof/journal/clock refused")
      ;; Operator halt (S0-f). A halt file stops every permit and signature; the
      ;; read-only commands keep working so a lost reply can still be resolved.
      (and (not= (kh-read root "halt") "")
           (not (or (= command "status-local") (= command "export-local") (= command "audit-local") (= command "audit-refusals-local"))))
        (let [logged (kh-log-refusal root config command "host/halted" (kg-hash command))]
          (kc-error "host halted by operator; no permit or signature is issued"))
      :else
      (cond
        (= command "export-local")
          (kc-output (str config "\n" policy "\n" (kh-read root "keyset.bundle")))
        (= command "audit-local")
          ;; Public permit/signature records, after complete proof validation.
          ;; This lets a caller resolve a lost reply without signing again.
          (kc-output journal)
        (= command "audit-refusals-local")
          (let [text (kh-read root "refusals")]
            (if (= (kh-refusals-scan text config) "") (kc-error "refusal log missing, damaged or over its bound")
              (kc-output text)))
        (= command "status-local")
          (kc-output (kh-status-text state cursor now))
        (= command "permit-local")
          (let [body (typed-cap-call 35 :string :string (kc-arg 2))
                permit (str "kagi.agent.permit.v1 " (kg-field state 1) " " (kg-field state 2) " " (kg-field state 3)
                         " " (if (= (kc-arg 3) "") (kg-field policy 5) (kc-arg 3)) " " (kg-field policy 2) " " (kg-field policy 3) " " (kg-hash body)
                         " " (kg-field cursor 3) " " (kg-field config 3) " " (+ (kg-number (kg-field cursor 1)) 1)
                         " " now " " (+ now (kg-number (kg-field policy 6))))
                signature (kh-sign-text (kh-read root "delegate.seed") permit)]
            (if (not= (kg-permit-problem state policy permit signature now (kg-number (kg-field cursor 1))
                         (kg-number (kg-field config 3)) (kg-field cursor 3)) "")
              (kc-error "local delegate refused") (kc-output (str permit " " signature "\n"))))
        (or (= command "sign-local") (= command "sign-local-line"))
          (let [request (typed-cap-call 35 :string :string (kc-arg 2))
                end (kc-line-end request 0)
                line (string-substring request 0 end)
                shaped (kg-line? line 14)
                permit (if shaped (kh-fields line 0 13) "") delegate (if shaped (kg-field line 13) "")
                body (typed-cap-call 35 :string :string (kc-arg 3))
                signature (if (and shaped (= (+ end 1) (string-length request))
                                   (= (kg-hash body) (kg-field permit 7)))
                  (kg-sign (hex-bytes (kh-read root "author.seed")) state policy permit delegate now
                    (kg-number (kg-field cursor 1)) (kg-number (kg-field config 3)) (kg-field cursor 3)) "")]
            (if (= signature "") (kc-error "sign request refused")
              (let [commit-time (kh-now)
                    entry (str "kagi.host.entry.v1 " commit-time " " permit " " delegate " " signature " " (kg-field cursor 4))
                    committed (and (>= commit-time now) (<= commit-time (kg-number (kg-field permit 12)))
                      (kh-write "A" root "journal" (str (kh-nul) journal (kh-nul) entry "\n")))
                    reply-time (kh-now)]
                (if (or (not committed) (< reply-time commit-time) (> reply-time (kg-number (kg-field permit 12))))
                  (kc-error "journal/clock/deadline refused; no signature released")
                  (if (= command "sign-local-line") (kc-output (str permit " " delegate " " signature "\n"))
                  (kc-output (str "{\"schema\":\"kagi.host.signature.v1\",\"mode\":\"local-software\",\"sequence\":" (kg-field permit 10)
                    ",\"author\":\"" (kg-field state 5) "\",\"permit\":\"" permit "\",\"delegateSignature\":\"" delegate
                    "\",\"signature\":\"" signature "\",\"journalHead\":\"" (kg-hash entry) "\"}\n")))))))
        ;; Binding (S0-e). sign-binding-local signs ONLY the binding statement, in
        ;; the domain of the role this root's author plays in it; it is not a
        ;; general signing oracle. bind-local verifies and records the binding once.
        (= command "sign-binding-local")
          (let [idpub (kc-arg 2) fpub (kc-arg 3) pin (kc-arg 4)
                statement (str "kagi.funds.binding.v1 " idpub " " fpub " " pin)
                role (cond (= (kg-field state 5) idpub) "identity" (= (kg-field state 5) fpub) "funds" :else "")]
            (if (or (= role "") (not (kg-public? idpub)) (not (kg-public? fpub)) (= idpub fpub) (not (kg-hex? pin 64)))
              (kc-error "binding sign refused")
              (kc-output (str (kh-sign-text (kh-read root "author.seed") (kg-binding-message role statement)) "\n"))))
        (= command "bind-local")
          (let [text (typed-cap-call 35 :string :string (kc-arg 2))
                binding (string-substring text 0 (kc-line-end text 0))
                bundle (typed-cap-call 35 :string :string (kc-arg 3))]
            (if (or (not= (kg-field policy 1) "funds") (not= (+ (kc-line-end text 0) 1) (string-length text))
                    (not= (kg-binding-problem binding (kc-verify-bundle bundle (kg-field binding 3)) (kg-field state 5)) "")
                    (not (kh-create root "binding" (str binding "\n" bundle))))
              (kc-error "binding refused")
              (kc-output (str "{\"schema\":\"kagi.host.binding.v1\",\"identity\":\"" (kg-field binding 1) "\",\"funds\":\"" (kg-field binding 2)
                              "\",\"identityKeyset\":\"" (kg-field binding 3) "\"}\n"))))
        ;; Funds (S0-c2). permit-funds-local builds the canonical TransferBody
        ;; itself from the request fields, checks the pinned limits against the
        ;; verified journal, and has the delegate sign a permit committing to that
        ;; body. Output: PERMIT(13) DELEGATE RECEIVER AMOUNT SPENDER_PREV NONCE TS.
        (= command "permit-funds-local")
          (let [receiver (kc-arg 2) amount (kc-arg 3) sprev (kc-arg 4) nonce (kc-arg 5) ts (kc-arg 6)
                spender (kg-did-of (kg-field state 5))
                body (kg-transfer-body spender receiver amount sprev nonce ts)
                spent (kh-spent journal config (kh-day now))
                permit (str "kagi.agent.permit.v1 " (kg-field state 1) " " (kg-field state 2) " " (kg-field state 3)
                         " en-transfer " (kg-field policy 2) " " (kg-field policy 3) " " (kg-hash body)
                         " " (kg-field cursor 3) " " (kg-field config 3) " " (+ (kg-number (kg-field cursor 1)) 1)
                         " " now " " (+ now (kg-number (kg-field policy 6))))
                signature (kh-sign-text (kh-read root "delegate.seed") permit)]
            (let [reason (cond (not= (kg-field policy 1) "funds") "host/role"
                               (not (kh-bound? root state)) "host/not-bound"
                               (not (kg-did-key? receiver)) "transfer/receiver"
                               (= receiver spender) "transfer/self"
                               (not (and (> (kg-number amount) 0) (>= (kg-number ts) 0) (kg-label? sprev) (kg-label? nonce))) "transfer/fields"
                               (not= (kg-funds-limits-problem policy receiver (kg-number amount) (kh-read root "allowlist") spent) "")
                                 (kg-funds-limits-problem policy receiver (kg-number amount) (kh-read root "allowlist") spent)
                               (not= (kg-permit-problem state policy permit signature now (kg-number (kg-field cursor 1))
                                      (kg-number (kg-field config 3)) (kg-field cursor 3)) "")
                                 (kg-permit-problem state policy permit signature now (kg-number (kg-field cursor 1))
                                   (kg-number (kg-field config 3)) (kg-field cursor 3))
                               :else "")]
              (if (not= reason "")
                (let [logged (kh-log-refusal root config command reason (kg-hash (str receiver " " amount " " sprev " " nonce " " ts)))]
                  (kc-error "funds permit refused"))
                (kc-output (str permit " " signature " " receiver " " amount " " sprev " " nonce " " ts "\n")))))
        (= command "sign-funds-local")
          (let [request (typed-cap-call 35 :string :string (kc-arg 2))
                end (kc-line-end request 0)
                line (string-substring request 0 end)
                shaped (and (kg-line? line 19) (= (+ end 1) (string-length request)))
                permit (if shaped (kh-fields line 0 13) "") delegate (if shaped (kg-field line 13) "")
                receiver (kg-field line 14) amount (kg-field line 15) sprev (kg-field line 16)
                nonce (kg-field line 17) ts (kg-field line 18)
                spent (kh-spent journal config (kh-day now))
                seed (hex-bytes (kh-read root "author.seed"))
                allow (kh-read root "allowlist")
                reason (cond (not shaped) "host/request-shape"
                             (not= (kg-field policy 1) "funds") "host/role"
                             (not (kh-bound? root state)) "host/not-bound"
                             :else (kg-transfer-problem seed state policy permit delegate now
                                     (kg-number (kg-field cursor 1)) (kg-number (kg-field config 3)) (kg-field cursor 3)
                                     receiver amount sprev nonce ts allow spent))
                signature (if (= reason "")
                  (kg-sign-transfer-hex seed state policy permit delegate now
                    (kg-number (kg-field cursor 1)) (kg-number (kg-field config 3)) (kg-field cursor 3)
                    receiver amount sprev nonce ts allow spent) "")]
            (if (= signature "")
              (let [logged (kh-log-refusal root config command (if (= reason "") "host/signer" reason) (kg-hash line))]
                (kc-error "funds sign request refused"))
              (let [commit-time (kh-now)
                    entry (str "kagi.host.fentry.v1 " commit-time " " permit " " delegate " " signature " " (kg-field cursor 4)
                               " " receiver " " amount " " sprev " " nonce " " ts)
                    committed (and (>= commit-time now) (<= commit-time (kg-number (kg-field permit 12)))
                      (kh-write "A" root "journal" (str (kh-nul) journal (kh-nul) entry "\n")))
                    reply-time (kh-now)
                    body (kg-transfer-body (kg-did-of (kg-field state 5)) receiver amount sprev nonce ts)]
                (if (or (not committed) (< reply-time commit-time) (> reply-time (kg-number (kg-field permit 12))))
                  (kc-error "journal/clock/deadline refused; no signature released")
                  (kc-output (str "{\"schema\":\"kagi.host.funds-signature.v1\",\"mode\":\"local-software\",\"sequence\":" (kg-field permit 10)
                    ",\"spender\":\"" (kg-did-of (kg-field state 5)) "\",\"transferId\":\"" (kg-transfer-id body)
                    "\",\"signature\":\"" (kg-b64u (hex-bytes signature)) "\",\"spentBefore\":" spent
                    ",\"journalHead\":\"" (kg-hash entry) "\"}\n"))))))
        :else (kc-error "unsupported local host operation")))))
(defn main [] :i64
  (let [command (kc-arg 0) root (kc-arg 1)]
    (cond (= command "init-local") (arena-scope (kh-init root))
          (= command "watch-local")
            (let [directory (kc-arg 2) count (kg-number (kc-arg 3))]
              (if (or (= root "") (= directory "") (< count 1) (> count 720) (not= (kc-arg 4) ""))
                (kc-error "usage: watch-local PRIVATE_ROOT PUBLIC_DIRECTORY SAMPLES_1_TO_720")
                (kh-watch root directory count)))
          (and (or (= command "status-local") (= command "export-local") (= command "audit-local") (= command "audit-refusals-local")) (not= root "") (= (kc-arg 2) "")) (kh-operate command root)
          (and (= command "permit-local") (not= root "") (not= (kc-arg 2) "") (= (kc-arg 4) "")) (kh-operate command root)
          (and (= command "halt-local") (not= root "") (= (kc-arg 2) "")) (arena-scope (kh-halt root))
          (and (= command "sign-binding-local") (not= root "") (not= (kc-arg 4) "") (= (kc-arg 5) "")) (arena-scope (kh-operate command root))
          (and (= command "bind-local") (not= root "") (not= (kc-arg 3) "") (= (kc-arg 4) "")) (arena-scope (kh-operate command root))
          (and (= command "permit-funds-local") (not= root "") (not= (kc-arg 6) "") (= (kc-arg 7) "")) (arena-scope (kh-operate command root))
          (and (= command "sign-funds-local") (not= root "") (not= (kc-arg 2) "") (= (kc-arg 3) "")) (arena-scope (kh-operate command root))
          (and (or (= command "sign-local") (= command "sign-local-line")) (not= root "") (not= (kc-arg 2) "") (not= (kc-arg 3) "") (= (kc-arg 4) "")) (arena-scope (kh-operate command root))
          :else (kc-error "native local host: init-local | status-local | permit-local | sign-local | permit-funds-local | sign-funds-local | sign-binding-local | bind-local | halt-local | audit-refusals-local; no legacy keys"))))
