;; Synthetic data only. Compile as native modules with the pinned KEM / AEAD
;; closure; each group gets its own image so temporary vectors are reclaimed.
(ns kagi.credential-envelope-test
  (:require [kagi.credential-envelope :as e] [x25519.core :as x] [mlkem.core :as k]
            [ed25519.selfhost :as ed])
  (:export [group-a group-b group-c group-d]))
(defn- kt-fill [n :i64 value :i64] :vector-i64
  (loop [i 0 v (vector-alloc n)] (if (= i n) v (recur (+ i 1) (vector-assoc! v i value)))))
(defn- kt-slice [v :vector-i64 start :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- kt-cat [a :vector-i64 b :vector-i64] :vector-i64
  (let [n (vector-count a) m (vector-count b)]
    (loop [i 0 out (vector-alloc (+ n m))] (if (= i (+ n m)) out
      (recur (+ i 1) (vector-assoc! out i (if (< i n) (vector-at a i) (vector-at b (- i n)))))))))
(defn- kt-eq [a :vector-i64 b :vector-i64] :bool
  (and (= (vector-count a) (vector-count b)) (loop [i 0] (if (= i (vector-count a)) true
    (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- kt-flip [v :vector-i64 i :i64] :vector-i64
  (let [out (kt-slice v 0 (vector-count v)) z (vector-assoc! out i (bit-xor (vector-at out i) 1))] out))
(defn group-a [] :i64
  (let [xs (kt-fill 32 3) kp (k/keygen (kt-fill 32 1) (kt-fill 32 2))
        dk (kt-slice kp 1184 2400) recipient (kt-cat (x/public-key xs) (kt-slice kp 0 1184))
        context (vector-i64 112 117 114 112 111 115 101) text (vector-i64 116 111 107 101 110)
        box (e/credential-seal recipient context text (kt-fill 32 4) (kt-fill 32 5) (kt-fill 12 6))
        ok (arena-scope (kt-eq (e/credential-open-unverified recipient context box xs dk) text))
        wrong-context (arena-scope (kt-eq (e/credential-open-unverified recipient (vector-i64 120) box xs dk) (vector-i64 -1)))
        altered (arena-scope (kt-eq (e/credential-open-unverified recipient context (kt-flip box 1136) xs dk) (vector-i64 -1)))]
    (+ (if ok 1 0) (if wrong-context 2 0) (if altered 4 0))))
(defn group-b [] :i64
  (let [xs (kt-fill 32 3) kp (k/keygen (kt-fill 32 1) (kt-fill 32 2))
        dk (kt-slice kp 1184 2400) recipient (kt-cat (x/public-key xs) (kt-slice kp 0 1184))
        context (vector-i64 1) text (vector-i64 2)
        box (e/credential-seal recipient context text (kt-fill 32 4) (kt-fill 32 5) (kt-fill 12 6))
        xbad (arena-scope (kt-eq (e/credential-open-unverified recipient context box (kt-fill 32 7) dk) (vector-i64 -1)))
        recipient-bad (arena-scope (kt-eq (e/credential-open-unverified (kt-flip recipient 32) context box xs dk) (vector-i64 -1)))
        magic-bad (arena-scope (kt-eq (e/credential-open-unverified recipient context (kt-flip box 0) xs dk) (vector-i64 -1)))
        empty-refused (= (vector-count (e/credential-seal recipient context (vector-i64) (kt-fill 32 4) (kt-fill 32 5) (kt-fill 12 6))) 0)
        long-refused (= (vector-count (e/credential-seal recipient context (kt-fill 4097 2) (kt-fill 32 4) (kt-fill 32 5) (kt-fill 12 6))) 0)
        nonce-refused (= (vector-count (e/credential-seal recipient context text (kt-fill 32 4) (kt-fill 32 5) (kt-fill 11 6))) 0)]
    (+ (if xbad 1 0) (if recipient-bad 2 0) (if magic-bad 4 0) (if empty-refused 8 0)
       (if long-refused 16 0) (if nonce-refused 32 0))))
(defn group-c [] :i64
  (let [xs (kt-fill 32 3) kp (k/keygen (kt-fill 32 1) (kt-fill 32 2))
        dk (kt-slice kp 1184 2400) recipient (kt-cat (x/public-key xs) (kt-slice kp 0 1184))
        context (vector-i64 1) box (e/credential-seal recipient context (vector-i64 2)
                                                       (kt-fill 32 4) (kt-fill 32 5) (kt-fill 12 6))
        a (arena-scope (kt-eq (e/credential-open-unverified recipient context (kt-flip box 4) xs dk) (vector-i64 -1)))
        b (arena-scope (kt-eq (e/credential-open-unverified recipient context (kt-flip box 36) xs dk) (vector-i64 -1)))
        c (arena-scope (kt-eq (e/credential-open-unverified recipient context (kt-flip box 1124) xs dk) (vector-i64 -1)))
        d (arena-scope (kt-eq (e/credential-open-unverified recipient context (kt-flip box 1152) xs dk) (vector-i64 -1)))
        e (arena-scope (kt-eq (e/credential-open-unverified recipient context box xs (kt-flip dk 1152)) (vector-i64 -1)))
        f (kt-eq (e/credential-open-unverified recipient context (vector-i64 1) xs dk) (vector-i64 -1))]
    (+ (if a 1 0) (if b 2 0) (if c 4 0) (if d 8 0) (if e 16 0) (if f 32 0))))

(defn group-d [] :i64
  (let [xs (kt-fill 32 3) kp (k/keygen (kt-fill 32 1) (kt-fill 32 2))
        dk (kt-slice kp 1184 2400) recipient (kt-cat (x/public-key xs) (kt-slice kp 0 1184))
        context (vector-i64 112 117 114 112 111 115 101) text (vector-i64 116 111 107 101 110)
        box (e/credential-seal recipient context text (kt-fill 32 4) (kt-fill 32 5) (kt-fill 12 6))
        seed (kt-fill 32 9) issuer (ed/public-from-seed seed) sig (kt-fill 64 0)
        made (ed/sign-into sig seed (e/credential-signing-message recipient context box))
        a (and (= made 0) (arena-scope (kt-eq (e/credential-open-signed recipient context box issuer sig xs dk) text)))
        b (arena-scope (kt-eq (e/credential-open-signed recipient (vector-i64 120) box issuer sig xs dk) (vector-i64 -1)))
        c (arena-scope (kt-eq (e/credential-open-signed recipient context (kt-flip box 1136) issuer sig xs dk) (vector-i64 -1)))
        d (arena-scope (kt-eq (e/credential-open-signed recipient context box (kt-flip issuer 0) sig xs dk) (vector-i64 -1)))
        f (arena-scope (kt-eq (e/credential-open-signed recipient context box issuer (kt-flip sig 0) xs dk) (vector-i64 -1)))
        g (arena-scope (kt-eq (e/credential-open-signed recipient context box (kt-fill 32 0) sig xs dk) (vector-i64 -1)))]
    (+ (if a 1 0) (if b 2 0) (if c 4 0) (if d 8 0) (if f 16 0) (if g 32 0))))
