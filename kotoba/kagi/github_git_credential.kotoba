;; Experimental in-memory Git credential helper response for the one bot
;; repository. The trusted host must receive a complete bounded helper input,
;; authenticate issuer/recipient and clock, enforce revocation and replay,
;; and write the returned secret bytes only to the intended Git helper pipe.
;; This is not a process launcher, secret store, Git configuration or broker.
(ns kagi.github-git-credential
  (:require [kagi.credential-envelope :as envelope])
  (:export [github-checkpoint-git-credential]))

(defn- ggc-token? [v :vector-i64] :bool
  (and (> (vector-count v) 0) (<= (vector-count v) 4096)
       (loop [i 0]
         (if (= i (vector-count v)) true
           (let [c (vector-at v i)]
             (and (>= c 33) (<= c 126) (recur (+ i 1))))))))
(defn- ggc-join [a :vector-i64 b :vector-i64] :vector-i64
  (let [n (vector-count a) m (vector-count b)]
    (loop [i 0 out (vector-alloc (+ n m))]
      (if (= i (+ n m)) out
        (recur (+ i 1) (vector-assoc! out i (if (< i n) (vector-at a i) (vector-at b (- i n)))))))))
(defn- ggc-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))

;; The expected input is the exact request observed for the fixed HTTPS URL
;; and credential.useHttpPath=true. Any alternate order, extra field, missing
;; path or operation other than `get` is deliberately refused. The host must
;; bind this input to Git's pipe and cannot treat the string as authentication.
;; Success returns sensitive protocol bytes; failure returns [-1]. Never put
;; the success value in argv, URL, logs, persistent config or model context.
(defn github-checkpoint-git-credential [action :string request :string
                                        recipient :vector-i64 issued :vector-i64 issuer :vector-i64
                                        x-secret :vector-i64 kem-secret :vector-i64 principal :string audience :string
                                        lease-id :string issued-ms :i64 expires-ms :i64 now-ms :i64] :vector-i64
  (if (or (not (= action "get"))
          (not (= request "protocol=https\nhost=github.com\npath=cloud-itonami/itonami-bot-state.git\n")))
    (vector-i64 -1)
    (let [token (envelope/github-checkpoint-open-issued recipient issued issuer x-secret kem-secret principal audience
                                                         lease-id issued-ms expires-ms now-ms)]
      (if (not (ggc-token? token)) (vector-i64 -1)
        (ggc-join (ggc-join (ggc-bytes "username=x-access-token\npassword=") token) (ggc-bytes "\n\n"))))))
