(ns kagi.agent-signer-gate (:export [main]))
(defn cg-report [name :string ok :bool] :i64
  (let [out (typed-cap-call 37 :string :string (str (if ok "PASS " "FAIL ") name "\n"))] (if ok 1 0)))

;; one funds request; every argument that a check varies is a parameter
(defn cc [seed :vector-i64 state :string policy :string permit :string signature :string
          now :i64 last :i64 receiver :string amount :string allow :string spent :i64] :string
  (kg-sign-transfer seed state policy permit signature now last 7 (kg-zero 64)
                    receiver amount (kg-v "spender-prev") (kg-v "nonce") (kg-v "ts") allow spent))
(defn cf [receiver :string amount :string now :i64 last :i64 spent :i64] :string
  (cc (hex-bytes (kg-v "seed")) (kg-v "funds-state") (kg-v "funds-policy") (kg-v "funds-permit") (kg-v "funds-sig")
      now last receiver amount (kg-v "allow-main") spent))
(defn bad-seed [] :vector-i64 (hex-bytes "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"))

(defn roles [] :i64
  (+ (cg-report "funds policy is admitted" (= (kg-policy-problem (kg-v "funds-policy")) ""))
  (+ (cg-report "en-transfer is not admitted for the agent role" (not (= (kg-policy-problem (kg-v "policy-agent-role")) "")))
  (+ (cg-report "funds role admits only en-transfer" (not (= (kg-policy-problem (kg-v "policy-wrong-purpose")) "")))
  (+ (cg-report "a funds policy without limits (old shape) is refused" (= (kg-policy-problem (kg-v "policy-old-shape")) "signer/policy-shape"))
  (+ (cg-report "a per-transaction cap above the daily cap is refused" (= (kg-policy-problem (kg-v "policy-cap-above-daily")) "signer/funds-limits"))
  (+ (cg-report "a zero per-transaction cap is refused" (= (kg-policy-problem (kg-v "policy-zero-cap")) "signer/funds-limits"))
     (cg-report "a non-hex allowlist digest is refused" (= (kg-policy-problem (kg-v "policy-bad-digest")) "signer/funds-limits")))))))))

(defn signing [] :i64
  (let [good (cf (kg-v "receiver") (kg-v "amount") 2000 0 0) seed (hex-bytes (kg-v "seed"))]
    (+ (cg-report "transfer signature equals ENGI's (base64url over transfer-id)" (= good (kg-v "sig-b64")))
    (+ (cg-report "the signature is stable for the same request" (= good (cf (kg-v "receiver") (kg-v "amount") 2000 0 0)))
    (+ (cg-report "transfer-id built in the signer equals ENGI's" (= (kg-transfer-id (kg-v "body")) (kg-v "tid")))
    (+ (cg-report "did:key of the author equals the spender" (= (kg-did-of (kg-v "author")) (kg-v "spender")))
    (+ (cg-report "kg-sign (action domain) refuses a funds permit" (= (kg-sign seed (kg-v "funds-state") (kg-v "funds-policy") (kg-v "funds-permit") (kg-v "funds-sig") 2000 0 7 (kg-zero 64)) ""))
       (cg-report "an agent-role permit cannot sign a transfer" (= (cc seed (kg-v "agent-state") (kg-v "agent-policy") (kg-v "agent-permit") (kg-v "agent-sig") 2000 0 (kg-v "receiver") (kg-v "amount") (kg-v "allow-main") 0) "")))))))))

(defn fields [] :i64
  (+ (cg-report "a changed amount is refused (body digest not committed by the permit)" (= (cf (kg-v "receiver") "8" 2000 0 0) ""))
  (+ (cg-report "a receiver that smuggles a field is refused" (= (cf (str (kg-v "receiver") "\namount=1") (kg-v "amount") 2000 0 0) ""))
  (+ (cg-report "a receiver that smuggles a field is refused even when the permit commits to that body" (= (cc (hex-bytes (kg-v "seed")) (kg-v "funds-state") (kg-v "funds-policy") (kg-v "inj-permit") (kg-v "inj-sig") 2000 0 (kg-v "inj-receiver") (kg-v "amount") (kg-v "allow-main") 0) ""))
  (+ (cg-report "a receiver with a space is refused" (= (cf (str (kg-v "receiver") " x") (kg-v "amount") 2000 0 0) ""))
  (+ (cg-report "a transfer to the spender itself is refused" (= (cf (kg-v "spender") (kg-v "amount") 2000 0 0) ""))
  (+ (cg-report "a non did:key receiver is refused" (= (cf "someone" (kg-v "amount") 2000 0 0) ""))
  (+ (cg-report "a zero amount is refused" (= (cf (kg-v "receiver") "0" 2000 0 0) ""))
     (cg-report "a non-canonical amount is refused" (= (cf (kg-v "receiver") "007" 2000 0 0) ""))))))))))

(defn permit-gate [] :i64
  (+ (cg-report "a replayed sequence is refused" (= (cf (kg-v "receiver") (kg-v "amount") 2000 1 0) ""))
  (+ (cg-report "an expired permit is refused" (= (cf (kg-v "receiver") (kg-v "amount") 30001 0 0) ""))
  (+ (cg-report "a permit from the future is refused" (= (cf (kg-v "receiver") (kg-v "amount") 500 0 0) ""))
  (+ (cg-report "a delegate signature over other text is refused" (= (cc (hex-bytes (kg-v "seed")) (kg-v "funds-state") (kg-v "funds-policy") (kg-v "funds-permit") (kg-v "bad-sig") 2000 0 (kg-v "receiver") (kg-v "amount") (kg-v "allow-main") 0) ""))
  (+ (cg-report "a seed that is not the keyset author is refused" (= (cc (bad-seed) (kg-v "funds-state") (kg-v "funds-policy") (kg-v "funds-permit") (kg-v "funds-sig") 2000 0 (kg-v "receiver") (kg-v "amount") (kg-v "allow-main") 0) ""))
     (cg-report "a short seed is refused" (= (cc (hex-bytes "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f") (kg-v "funds-state") (kg-v "funds-policy") (kg-v "funds-permit") (kg-v "funds-sig") 2000 0 (kg-v "receiver") (kg-v "amount") (kg-v "allow-main") 0) ""))))))))

(defn limits [] :i64
  (+ (cg-report "spending up to the daily cap exactly is signed" (= (cf (kg-v "receiver") (kg-v "amount") 2000 0 13) (kg-v "sig-b64")))
  (+ (cg-report "spending past the daily cap is refused" (= (cf (kg-v "receiver") (kg-v "amount") 2000 0 14) ""))
  (+ (cg-report "a negative spent value is refused" (= (cf (kg-v "receiver") (kg-v "amount") 2000 0 -1) ""))
  (+ (cg-report "an amount above the per-transaction cap is refused even when the permit commits to it" (= (cc (hex-bytes (kg-v "seed")) (kg-v "funds-state") (kg-v "funds-policy") (kg-v "cap-permit") (kg-v "cap-sig") 2000 0 (kg-v "receiver") (kg-v "cap-amount") (kg-v "allow-main") 0) ""))
  (+ (cg-report "an allowlist that still lists the receiver but differs from the pinned digest is refused" (= (cc (hex-bytes (kg-v "seed")) (kg-v "funds-state") (kg-v "funds-policy") (kg-v "funds-permit") (kg-v "funds-sig") 2000 0 (kg-v "receiver") (kg-v "amount") (kg-v "allow-forged") 0) ""))
  (+ (cg-report "an empty allowlist is refused" (= (cc (hex-bytes (kg-v "seed")) (kg-v "funds-state") (kg-v "funds-policy") (kg-v "funds-permit") (kg-v "funds-sig") 2000 0 (kg-v "receiver") (kg-v "amount") "" 0) ""))
  (+ (cg-report "a receiver missing from the pinned allowlist is refused" (= (cc (hex-bytes (kg-v "seed")) (kg-v "other-state") (kg-v "other-policy") (kg-v "other-permit") (kg-v "other-sig") 2000 0 (kg-v "receiver") (kg-v "amount") (kg-v "allow-other") 0) ""))
     (cg-report "an allowlist entry that only extends the receiver does not match it" (= (cc (hex-bytes (kg-v "seed")) (kg-v "prefix-state") (kg-v "prefix-policy") (kg-v "prefix-permit") (kg-v "prefix-sig") 2000 0 (kg-v "receiver") (kg-v "amount") (kg-v "allow-prefix") 0) ""))))))))))

(defn main [] :i64
  (+ (roles) (+ (signing) (+ (fields) (+ (permit-gate) (limits))))))
