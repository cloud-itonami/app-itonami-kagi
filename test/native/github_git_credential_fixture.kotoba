;; Synthetic diagnostic helper only. No secrets or real GitHub calls.
(ns test.github-git-credential-fixture
  (:require [kagi.github-issuance-envelope :as i] [kagi.github-git-credential :as g]
            [x25519.core :as x] [mlkem.core :as k] [ed25519.selfhost :as ed])
  (:export [main]))
(defn- fill [n :i64 value :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i value)))))
(defn- slice [v :vector-i64 start :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
  (let [n (vector-count a) m (vector-count b)]
    (loop [i 0 out (vector-alloc (+ n m))] (if (= i (+ n m)) out
      (recur (+ i 1) (vector-assoc! out i (if (< i n) (vector-at a i) (vector-at b (- i n)))))))))
(defn main [] :i64
  (let [action (typed-cap-call 38 :string :string "0") request (typed-cap-call 41 :string :string "")
        now 1793664000000 expires 1793665800000 xs (fill 32 3)
        kp (k/keygen (fill 32 1) (fill 32 2)) dk (slice kp 1184 2400)
        recipient (cat (x/public-key xs) (slice kp 0 1184))
        id "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        seed (fill 32 9) issuer (ed/public-from-seed seed)
        response (vector-i64-from-bytes (string-to-utf8 "{\"token\":\"synthetic-token\",\"expires_at\":\"2026-11-03T00:30:00Z\",\"permissions\":{\"contents\":\"write\",\"metadata\":\"read\"},\"repository_selection\":\"selected\",\"repositories\":[{\"id\":123,\"full_name\":\"cloud-itonami/itonami-bot-state\",\"private\":true}]}"))
        issued (i/github-checkpoint-signed-issue response 201 now [3600 3600 123]
                 "cloud-itonami/itonami-bot-state" "bot-one" true recipient "bot-one" "host-one" id
                 (fill 32 4) (fill 32 5) (fill 12 6) seed issuer)
        result (g/github-checkpoint-git-credential action request recipient issued issuer xs dk "bot-one" "host-one" id now expires now)]
    (if (or (= (vector-count result) 0) (= (vector-at result 0) -1)) 1
      (let [ignored (typed-cap-call 37 :string :string (string-from-utf8 (bytes-from-vector-i64 result)))
            cleared (g/github-checkpoint-clear-credential! result)] (if cleared 0 1)))))
